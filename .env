# Base URL for the REST API (no trailing slash)
BASE_URL=http://localhost:3000

# Centrifuge / WebSocket connection endpoint
CENTRIFUGE_URL=ws://localhost:8000/connection/websocket

# Set to "false" once the real backend is connected. While true (or unset),
# every services/*Api.js call is served from the in-memory mock dataset in
# src/mocks/, so the UI is fully explorable before the backend exists.
VITE_USE_MOCK_API=false
