# Shared host+protocol for every backend service — each services/*Api.js
# file appends its own port to this (e.g. `${BASE_HOST}:3032`). Change
# this one value when switching environments; ports stay as-is.
VITE_BASE_HOST=http://localhost

# Centrifuge / WebSocket connection endpoint
VITE_CENTRIFUGE_URL=ws://localhost:8000/connection/websocket

# Set to "false" once the real backend is connected. While true (or unset),
# every services/*Api.js call is served from the in-memory mock dataset in
# src/mocks/, so the UI is fully explorable before the backend exists.
VITE_USE_MOCK_API=false
